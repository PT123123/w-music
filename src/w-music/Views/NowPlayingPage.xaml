<Page
    x:Class="w_music.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:w_music"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== left: cover, spectrum, transport ===== -->
        <StackPanel Grid.Column="0" Padding="36,28" Spacing="14">
            <Border Width="220" Height="220"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <FontIcon Glyph="&#xEC4F;" FontSize="72" Foreground="{ThemeResource WmAccentBrush}" />
            </Border>

            <TextBlock Text="{x:Bind Player.Title, Mode=OneWay}"
                       FontSize="19"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind Player.Artist, Mode=OneWay}"
                       FontSize="13"
                       Opacity="0.7"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center" />

            <Canvas x:Name="SpectrumCanvas" Height="56" Margin="0,8,0,0" />

            <Slider x:Name="ProgressSlider"
                    Minimum="0"
                    Maximum="100"
                    StepFrequency="0.5"
                    IsThumbToolTipEnabled="False" />

            <Grid>
                <TextBlock x:Name="PosText" Text="00:00" FontSize="12" Opacity="0.75" />
                <TextBlock x:Name="DurText" Text="00:00" FontSize="12" Opacity="0.75" HorizontalAlignment="Right" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,6,0,0">
                <Button x:Name="PrevBtn" Width="42" Height="42" Padding="0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE892;" FontSize="16" />
                </Button>
                <Button x:Name="PlayPauseBtn" Width="54" Height="54" Padding="0">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="20" />
                </Button>
                <Button x:Name="NextBtn" Width="42" Height="42" Padding="0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE893;" FontSize="16" />
                </Button>
                <Button x:Name="ModeBtn" Content="{x:Bind Player.ModeText, Mode=OneWay}" Padding="10,6" />
                <Button x:Name="FavBtn" Width="42" Height="42" Padding="0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xEB51;" FontSize="17" />
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- ===== right: lyrics ===== -->
        <Grid Grid.Column="1" Padding="24,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="歌词" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                    <Button x:Name="SlowerBtn" Content="−0.5s" Padding="8,5" />
                    <Button x:Name="FasterBtn" Content="+0.5s" Padding="8,5" />
                    <Button x:Name="ResetBtn" Content="重置" Padding="8,5" />
                    <TextBlock x:Name="OffsetText"
                               Text="偏移 0 ms"
                               FontSize="12"
                               Opacity="0.7"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <ListView x:Name="LyricList"
                      Grid.Row="1"
                      Margin="0,12,0,0"
                      ItemsSource="{x:Bind Player.Lyrics, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="True">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:LyricLineItem">
                        <TextBlock Text="{x:Bind Text}"
                                   FontSize="{x:Bind FontSize, Mode=OneWay}"
                                   Foreground="{x:Bind Foreground, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Padding="0,7" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Grid.Row="2"
                       Margin="0,10,0,0"
                       FontSize="11.5"
                       Opacity="0.6"
                       TextWrapping="Wrap">
                点击任意一行即可跳转到该时间点。没有歌词时，把与音乐文件同名的 .lrc 放在同一目录（或 lyrics 子目录）即可自动加载；用 ±0.5s 可微调整体偏移。
            </TextBlock>
        </Grid>
    </Grid>
</Page>
