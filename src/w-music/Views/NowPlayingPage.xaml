<Page
    x:Class="w_music.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:w_music"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 页面背景透明，露出 MainWindow 根节点的主题渐变 -->
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左：封面、频谱、进度、控制 ===== -->
        <StackPanel Grid.Column="0" Padding="48,32,32,28" Spacing="16">
            <!-- 封面区是电台手势的落点：左右滑 = 点赞/差评（不打断播放），
                 长按 = 差评。拖动有橡皮筋限幅，松手回弹。 -->
            <Border x:Name="Cover" Width="260" Height="260"
                    CornerRadius="18"
                    Background="{ThemeResource WmCardBrush}"
                    BorderBrush="{ThemeResource WmBorderBrush}"
                    BorderThickness="1"
                    ManipulationMode="TranslateX">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="CoverShift" />
                </Border.RenderTransform>
                <FontIcon Glyph="&#xEC4F;" FontSize="84" Foreground="{ThemeResource WmAccentBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="{x:Bind Player.Title, Mode=OneWay}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind Player.Artist, Mode=OneWay}"
                       FontSize="13"
                       Opacity="0.65"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center"
                       Margin="0,-8,0,0" />

            <Canvas x:Name="SpectrumCanvas" Height="56" Margin="0,6,0,0" />

            <Slider x:Name="ProgressSlider"
                    Minimum="0"
                    Maximum="100"
                    StepFrequency="0.5"
                    IsThumbToolTipEnabled="False" />

            <Grid Margin="0,-10,0,0">
                <TextBlock x:Name="PosText" Text="00:00" FontSize="12" Opacity="0.7" />
                <TextBlock x:Name="DurText" Text="00:00" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,2,0,0">
                <Button x:Name="PrevBtn" Width="42" Height="42" CornerRadius="21" Padding="0"
                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="上一曲">
                    <FontIcon Glyph="&#xE892;" FontSize="16" />
                </Button>
                <!-- 播放键直接用主题色画在渐变背景上，绿色主题下会糊成一片，
                     所以这里跟主按钮统一：白底 + 主题色图标 -->
                <Button x:Name="PlayPauseBtn" Width="56" Height="56" CornerRadius="28" Padding="0"
                        Background="#F2FFFFFF" Foreground="{ThemeResource WmAccentBrush}" BorderThickness="0"
                        ToolTipService.ToolTip="播放 / 暂停">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="20" />
                </Button>
                <Button x:Name="NextBtn" Width="42" Height="42" CornerRadius="21" Padding="0"
                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="下一曲">
                    <FontIcon Glyph="&#xE893;" FontSize="16" />
                </Button>
                <Button x:Name="ModeBtn" Content="{x:Bind Player.ModeText, Mode=OneWay}" Padding="12,6" CornerRadius="14"
                        ToolTipService.ToolTip="播放模式：推荐流（默认，按口味和时间窗）→ 顺序 → 列表循环 → 随机 → 单曲循环" />
                <Button x:Name="FavBtn" Width="42" Height="42" CornerRadius="21" Padding="0"
                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="喜欢">
                    <FontIcon Glyph="&#xEB51;" FontSize="17" />
                </Button>
            </StackPanel>

            <TextBlock FontSize="11" Opacity="0.45" HorizontalAlignment="Center"
                       Margin="0,-6,0,0" TextWrapping="Wrap" HorizontalTextAlignment="Center">
                左滑封面 = 差评换一首，右滑 = 点赞加权；长按封面 = 差评。
            </TextBlock>
        </StackPanel>

        <!-- ===== 右：推荐流「接下来」卡片 + 歌词 ===== -->
        <Grid Grid.Column="1" Padding="28,32,40,28" BorderBrush="{ThemeResource WmBorderBrush}" BorderThickness="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="歌词" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                    <Button x:Name="SlowerBtn" Content="−0.5s" Padding="10,5" CornerRadius="12" />
                    <Button x:Name="FasterBtn" Content="+0.5s" Padding="10,5" CornerRadius="12" />
                    <Button x:Name="ResetBtn" Content="重置" Padding="10,5" CornerRadius="12" />
                    <TextBlock x:Name="OffsetText"
                               Text="偏移 0 ms"
                               FontSize="12"
                               Opacity="0.6"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- 推荐流「接下来」：预取缓冲的预告（可点播/可换）+ 诚实的状态说明。
                 推荐流模式下下一曲从缓冲出队（零等待）；顺序模式下预告队列的
                 下一首；随机模式明确说"不预告"。 -->
            <Border Grid.Row="1"
                    x:Name="FlowCard"
                    Margin="0,12,0,0"
                    Padding="14,10,14,10"
                    CornerRadius="12"
                    Background="{ThemeResource WmCardBrush}"
                    BorderBrush="{ThemeResource WmBorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock Text="{x:Bind Player.FlowHeaderText, Mode=OneWay}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button x:Name="FlowRefreshBtn"
                                Content="换一个"
                                FontSize="12"
                                Padding="10,4"
                                CornerRadius="10"
                                HorizontalAlignment="Right"
                                Visibility="{x:Bind Player.FlowRefreshVisibility, Mode=OneWay}"
                                ToolTipService.ToolTip="跳过这首预告，推荐流会补一首新的" />
                    </Grid>

                    <ListView x:Name="FlowUpNextList"
                              ItemsSource="{x:Bind Player.FlowUpNext, Mode=OneWay}"
                              MaxHeight="128"
                              SelectionMode="None"
                              IsItemClickEnabled="True">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:RecommendItem">
                                <Grid Padding="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="0">
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Artist}"
                                                   FontSize="11"
                                                   Opacity="0.55"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{x:Bind HasArtist}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                        <TextBlock Text="{x:Bind ScoreText}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource WmAccentBrush}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Bind Reasons}"
                                                   FontSize="10"
                                                   Opacity="0.5"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Right"
                                                   Visibility="{x:Bind ReasonsVisibility}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="{x:Bind Player.FlowStreamText, Mode=OneWay}"
                               FontSize="11"
                               Opacity="0.55"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ListView x:Name="LyricList"
                      Grid.Row="2"
                      Margin="0,12,0,0"
                      ItemsSource="{x:Bind Player.Lyrics, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="True">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:LyricLineItem">
                        <TextBlock Text="{x:Bind Text}"
                                   FontSize="{x:Bind FontSize, Mode=OneWay}"
                                   Foreground="{x:Bind Foreground, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Padding="0,7" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Grid.Row="3"
                       Margin="0,10,0,0"
                       FontSize="11.5"
                       Opacity="0.55"
                       TextWrapping="Wrap">
                点击任意一行即可跳转到该时间点。没有歌词时，把与音乐文件同名的 .lrc 放在同一目录（或 lyrics 子目录）即可自动加载；用 ±0.5s 可微调整整体偏移。
            </TextBlock>
        </Grid>

        <!-- 电台 / 手势的轻提示：不打断播放，几秒后自动消失 -->
        <TextBlock x:Name="FlowToast"
                   Grid.Column="0" Grid.ColumnSpan="2"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,18"
                   FontSize="13"
                   Opacity="0"
                   IsHitTestVisible="False"
                   Text="{x:Bind Player.FlowStatusText, Mode=OneWay}" />
    </Grid>
</Page>
