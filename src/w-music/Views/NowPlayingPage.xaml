<Page
    x:Class="w_music.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:w_music"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 页面背景透明，露出 MainWindow 根节点的主题渐变 -->
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左：封面、频谱、进度、控制 ===== -->
        <StackPanel Grid.Column="0" Padding="48,32,32,28" Spacing="16">
            <Border Width="260" Height="260"
                    CornerRadius="18"
                    Background="{ThemeResource WmCardBrush}"
                    BorderBrush="{ThemeResource WmBorderBrush}"
                    BorderThickness="1">
                <FontIcon Glyph="&#xEC4F;" FontSize="84" Foreground="{ThemeResource WmAccentBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="{x:Bind Player.Title, Mode=OneWay}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind Player.Artist, Mode=OneWay}"
                       FontSize="13"
                       Opacity="0.65"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center"
                       Margin="0,-8,0,0" />

            <Canvas x:Name="SpectrumCanvas" Height="56" Margin="0,6,0,0" />

            <Slider x:Name="ProgressSlider"
                    Minimum="0"
                    Maximum="100"
                    StepFrequency="0.5"
                    IsThumbToolTipEnabled="False" />

            <Grid Margin="0,-10,0,0">
                <TextBlock x:Name="PosText" Text="00:00" FontSize="12" Opacity="0.7" />
                <TextBlock x:Name="DurText" Text="00:00" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,2,0,0">
                <Button x:Name="PrevBtn" Width="42" Height="42" CornerRadius="21" Padding="0"
                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="上一曲">
                    <FontIcon Glyph="&#xE892;" FontSize="16" />
                </Button>
                <!-- 播放键直接用主题色画在渐变背景上，绿色主题下会糊成一片，
                     所以这里跟主按钮统一：白底 + 主题色图标 -->
                <Button x:Name="PlayPauseBtn" Width="56" Height="56" CornerRadius="28" Padding="0"
                        Background="#F2FFFFFF" Foreground="{ThemeResource WmAccentBrush}" BorderThickness="0"
                        ToolTipService.ToolTip="播放 / 暂停">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="20" />
                </Button>
                <Button x:Name="NextBtn" Width="42" Height="42" CornerRadius="21" Padding="0"
                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="下一曲">
                    <FontIcon Glyph="&#xE893;" FontSize="16" />
                </Button>
                <Button x:Name="ModeBtn" Content="{x:Bind Player.ModeText, Mode=OneWay}" Padding="12,6" CornerRadius="14" />
                <Button x:Name="FavBtn" Width="42" Height="42" CornerRadius="21" Padding="0"
                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="喜欢">
                    <FontIcon Glyph="&#xEB51;" FontSize="17" />
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- ===== 右：歌词 ===== -->
        <Grid Grid.Column="1" Padding="28,32,40,28" BorderBrush="{ThemeResource WmBorderBrush}" BorderThickness="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="歌词" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                    <Button x:Name="SlowerBtn" Content="−0.5s" Padding="10,5" CornerRadius="12" />
                    <Button x:Name="FasterBtn" Content="+0.5s" Padding="10,5" CornerRadius="12" />
                    <Button x:Name="ResetBtn" Content="重置" Padding="10,5" CornerRadius="12" />
                    <TextBlock x:Name="OffsetText"
                               Text="偏移 0 ms"
                               FontSize="12"
                               Opacity="0.6"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <ListView x:Name="LyricList"
                      Grid.Row="1"
                      Margin="0,12,0,0"
                      ItemsSource="{x:Bind Player.Lyrics, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="True">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:LyricLineItem">
                        <TextBlock Text="{x:Bind Text}"
                                   FontSize="{x:Bind FontSize, Mode=OneWay}"
                                   Foreground="{x:Bind Foreground, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Padding="0,7" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Grid.Row="2"
                       Margin="0,10,0,0"
                       FontSize="11.5"
                       Opacity="0.55"
                       TextWrapping="Wrap">
                点击任意一行即可跳转到该时间点。没有歌词时，把与音乐文件同名的 .lrc 放在同一目录（或 lyrics 子目录）即可自动加载；用 ±0.5s 可微调整体偏移。
            </TextBlock>
        </Grid>
    </Grid>
</Page>
