<Page
    x:Class="w_music.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:w_music"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== playlists ===== -->
        <Border Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button x:Name="ShowAllButton"
                        Grid.Row="0"
                        Content="全部音乐"
                        HorizontalAlignment="Stretch"
                        Margin="10,10,10,4" />

                <ListView x:Name="PlaylistList"
                          Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PlaylistItem">
                            <Grid Padding="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="14" Margin="0,0,10,0"
                                          Foreground="{ThemeResource WmAccentBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind TrackCount}" FontSize="11" Opacity="0.6" Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Margin="10" Spacing="6">
                    <Button x:Name="NewPlaylistButton" Content="新建歌单" HorizontalAlignment="Stretch" />
                    <Button x:Name="DeletePlaylistButton" Content="删除歌单" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== tracks ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="16,10"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="PlayPlaylistButton" Padding="10,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="播放" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="ListTitle"
                                   Text="全部音乐"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               FontSize="12"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- column header -->
            <Border Grid.Row="1"
                    VerticalAlignment="Top"
                    Padding="16,6"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="标题" FontSize="11" Opacity="0.6" />
                    <TextBlock Grid.Column="1" Text="艺术家" FontSize="11" Opacity="0.6" />
                    <TextBlock Grid.Column="2" Text="专辑" FontSize="11" Opacity="0.6" />
                    <TextBlock Grid.Column="3" Text="时长" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="操作" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <ListView x:Name="TrackList"
                      Grid.Row="1"
                      Margin="0,32,0,0"
                      SelectionMode="None"
                      IsItemClickEnabled="True">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TrackItem">
                        <Grid Padding="6,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Artist}" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Album}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind DurationText}" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                                <Button Tag="{x:Bind Id}" Click="OnFavoriteClick" Width="32" Height="32" Padding="0"
                                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="喜欢">
                                    <FontIcon Glyph="&#xEB51;" FontSize="14" />
                                </Button>
                                <Button Tag="{x:Bind Id}" Click="OnAddToPlaylistClick" Width="32" Height="32" Padding="0"
                                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="添加到歌单">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
