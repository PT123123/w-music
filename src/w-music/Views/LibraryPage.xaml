<Page
    x:Class="w_music.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:w_music"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource WmBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧：歌单 ===== -->
        <Border Grid.Column="0"
                Background="{ThemeResource WmSideBrush}"
                BorderBrush="{ThemeResource WmCardBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button x:Name="ShowAllButton"
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        Margin="12,12,12,6"
                        Padding="12,8"
                        HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8D6;" FontSize="15" Foreground="{ThemeResource WmAccentBrush}" />
                        <TextBlock Text="全部音乐" FontWeight="SemiBold" FontSize="14" />
                    </StackPanel>
                </Button>

                <ListView x:Name="PlaylistList"
                          Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                          SelectionMode="Single"
                          Margin="8,0,8,0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Padding" Value="10,7" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PlaylistItem">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="14" Margin="0,0,10,0"
                                          Foreground="{ThemeResource WmAccentBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind TrackCount}" FontSize="11" Opacity="0.55" Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Margin="12,8,12,12" Spacing="6">
                    <Button x:Name="NewPlaylistButton" Content="新建歌单" HorizontalAlignment="Stretch"
                            Style="{StaticResource QqAccentButtonStyle}" FontWeight="SemiBold" />
                    <Button x:Name="DeletePlaylistButton" Content="删除歌单" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 右侧：曲目 ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Padding="24,16"
                    Background="{ThemeResource WmBgBrush}"
                    BorderBrush="{ThemeResource WmCardBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                        <Button x:Name="PlayPlaylistButton" Padding="16,8"
                                Style="{StaticResource QqAccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="播放" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="ListTitle"
                                   Text="全部音乐"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               FontSize="12"
                               Opacity="0.65"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 列头 -->
            <Border Grid.Row="1"
                    VerticalAlignment="Top"
                    Padding="24,10"
                    BorderBrush="{ThemeResource WmCardBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="标题" FontSize="11" Opacity="0.55" />
                    <TextBlock Grid.Column="1" Text="艺术家" FontSize="11" Opacity="0.55" />
                    <TextBlock Grid.Column="2" Text="专辑" FontSize="11" Opacity="0.55" />
                    <TextBlock Grid.Column="3" Text="时长" FontSize="11" Opacity="0.55" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="操作" FontSize="11" Opacity="0.55" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <ListView x:Name="TrackList"
                      Grid.Row="1"
                      Margin="8,36,8,0"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemContainerStyle="{StaticResource QqTrackContainerStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TrackItem">
                        <Grid Padding="16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Artist}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Album}" FontSize="12" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind DurationText}" FontSize="12" Opacity="0.6" HorizontalAlignment="Right" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                                <Button Tag="{x:Bind Id}" Click="OnFavoriteClick" Width="32" Height="32" CornerRadius="16" Padding="0"
                                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="喜欢">
                                    <FontIcon Glyph="&#xEB51;" FontSize="14" />
                                </Button>
                                <Button Tag="{x:Bind Id}" Click="OnAddToPlaylistClick" Width="32" Height="32" CornerRadius="16" Padding="0"
                                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="添加到歌单">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
