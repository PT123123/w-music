<Page
    x:Class="w_music.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:w_music"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 页面背景一律透明：整窗那一层主题渐变（MainWindow 的 RootHost）直接透过来 -->
    <Grid Background="Transparent">
        <ScrollViewer>
            <StackPanel Padding="28,20,28,28" Spacing="24">

                <!-- ===== 顶部横幅（QQ 音乐风格）：薄白玻璃，叠在主题渐变上 ===== -->
                <Border CornerRadius="14"
                        Padding="28,24"
                        BorderBrush="{ThemeResource WmBorderBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource WmHeroGradientBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="发现音乐"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                   FontSize="13"
                                   Foreground="#E6FFFFFF"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                            <Button x:Name="AddFolderButton" Content="添加音乐文件夹"
                                    Background="White" Foreground="{ThemeResource WmAccentBrush}"
                                    FontWeight="SemiBold" Padding="18,8" />
                            <Button x:Name="RescanButton" Content="重新扫描"
                                    Foreground="White" Padding="14,8" />
                            <Button x:Name="PlayAllButton" Content="播放全部"
                                    Foreground="White" Padding="14,8" />
                            <ProgressRing x:Name="ScanRing"
                                          Width="18" Height="18"
                                          Foreground="White"
                                          IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                          VerticalAlignment="Center" />
                        </StackPanel>
                        <AutoSuggestBox x:Name="SearchBox"
                                        PlaceholderText="在本地曲库中搜索：标题 / 艺术家 / 专辑"
                                        QueryIcon="Find"
                                        MaxWidth="520"
                                        HorizontalAlignment="Left"
                                        Background="#26FFFFFF"
                                        Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- ===== 搜索结果显示区 ===== -->
                <StackPanel x:Name="SearchPanel" Visibility="Collapsed" Spacing="12">
                    <TextBlock Text="搜索结果" FontSize="20" FontWeight="SemiBold" />
                    <GridView x:Name="SearchList"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemContainerStyle="{StaticResource QqCardContainerStyle}">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:TrackItem">
                                <Grid Width="148" Margin="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="10"
                                            Background="{ThemeResource WmCardBrush}"
                                            BorderBrush="{ThemeResource WmBorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <FontIcon Glyph="&#xEC4F;" FontSize="28" Foreground="{ThemeResource WmAccentBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Width="30" Height="30" CornerRadius="15" Margin="0,0,8,8"
                                                    Background="{ThemeResource WmAccentBrush}">
                                                <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Margin="2,8,2,0" />
                                    <TextBlock Grid.Row="2" Text="{x:Bind Artist}" FontSize="11" Opacity="0.6"
                                               TextTrimming="CharacterEllipsis" Margin="2,2,2,0" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- ===== 每日推荐 ===== -->
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="每日推荐" Style="{StaticResource QqSectionTitleStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <TextBlock Text="更多" FontSize="13" Opacity="0.55" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xE76C;" FontSize="12" Opacity="0.55" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <GridView x:Name="ShuffleList"
                              ItemsSource="{x:Bind ViewModel.DiscoverShuffle, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemContainerStyle="{StaticResource QqCardContainerStyle}">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:TrackItem">
                                <Grid Width="148" Margin="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="10"
                                            Background="{ThemeResource WmCardBrush}"
                                            BorderBrush="{ThemeResource WmBorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <FontIcon Glyph="&#xEC4F;" FontSize="28" Foreground="{ThemeResource WmAccentBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Width="30" Height="30" CornerRadius="15" Margin="0,0,8,8"
                                                    Background="{ThemeResource WmAccentBrush}">
                                                <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Margin="2,8,2,0" />
                                    <TextBlock Grid.Row="2" Text="{x:Bind Artist}" FontSize="11" Opacity="0.6"
                                               TextTrimming="CharacterEllipsis" Margin="2,2,2,0" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- ===== 最近添加 ===== -->
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="最近添加" Style="{StaticResource QqSectionTitleStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <TextBlock Text="更多" FontSize="13" Opacity="0.55" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xE76C;" FontSize="12" Opacity="0.55" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <GridView x:Name="RecentList"
                              ItemsSource="{x:Bind ViewModel.DiscoverRecent, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemContainerStyle="{StaticResource QqCardContainerStyle}">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:TrackItem">
                                <Grid Width="148" Margin="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="10"
                                            Background="{ThemeResource WmCardBrush}"
                                            BorderBrush="{ThemeResource WmBorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <FontIcon Glyph="&#xEC4F;" FontSize="28" Foreground="{ThemeResource WmAccentBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Width="30" Height="30" CornerRadius="15" Margin="0,0,8,8"
                                                    Background="{ThemeResource WmAccentBrush}">
                                                <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Margin="2,8,2,0" />
                                    <TextBlock Grid.Row="2" Text="{x:Bind Artist}" FontSize="11" Opacity="0.6"
                                               TextTrimming="CharacterEllipsis" Margin="2,2,2,0" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- ===== 常听 ===== -->
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="常听" Style="{StaticResource QqSectionTitleStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <TextBlock Text="更多" FontSize="13" Opacity="0.55" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xE76C;" FontSize="12" Opacity="0.55" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <GridView x:Name="TopList"
                              ItemsSource="{x:Bind ViewModel.DiscoverTop, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemContainerStyle="{StaticResource QqCardContainerStyle}">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:TrackItem">
                                <Grid Width="148" Margin="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="10"
                                            Background="{ThemeResource WmCardBrush}"
                                            BorderBrush="{ThemeResource WmBorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <FontIcon Glyph="&#xEC4F;" FontSize="28" Foreground="{ThemeResource WmAccentBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Width="30" Height="30" CornerRadius="15" Margin="0,0,8,8"
                                                    Background="{ThemeResource WmAccentBrush}">
                                                <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Margin="2,8,2,0" />
                                    <TextBlock Grid.Row="2" Text="{x:Bind Artist}" FontSize="11" Opacity="0.6"
                                               TextTrimming="CharacterEllipsis" Margin="2,2,2,0" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <TextBlock FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                           Text="想找新歌？左侧「个性推荐」会按音频听感推荐本地曲库里相近的歌，「在线发现」标签页可以从在线源搜索并直接下载到本地曲库。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
