<Page
    x:Class="w_music.OnlinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:w_music"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28,20,28,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== header (title + tagline + library tools, like a-music's 发现 header) ===== -->
        <Border Grid.Row="0"
                CornerRadius="10"
                Padding="20,16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE774;" FontSize="20" Foreground="{ThemeResource WmAccentBrush}" Margin="0,2,0,0" />
                        <TextBlock Text="在线发现" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="HeaderTagline"
                               FontSize="12.5" Opacity="0.75" TextWrapping="Wrap" />
                    <TextBlock x:Name="LibraryStatsLine"
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="1" x:Name="RescanButton"
                        Content="重新扫描"
                        VerticalAlignment="Top"
                        ToolTipService.ToolTip="重新扫描本地音乐文件夹" />
            </Grid>
        </Border>

        <!-- ===== source switcher ===== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <ToggleButton x:Name="QqTab" Tag="qq" Click="OnSourceTabClick" Content="QQ音乐" />
            <ToggleButton x:Name="Net24Tab" Tag="net24" Click="OnSourceTabClick" Content="无损音乐" />
            <ToggleButton x:Name="AdapterTab" Tag="adapter" Click="OnSourceTabClick" Content="自定义源" />
        </StackPanel>

        <!-- ===== sections ===== -->
        <Grid Grid.Row="2">
            <!-- ============ QQ 音乐 ============ -->
            <Grid x:Name="QqSection" RowSpacing="8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="QqQueryBox" Width="380"
                                 PlaceholderText="搜索歌曲 / 歌手 / 专辑"
                                 KeyDown="OnQueryBoxKeyDown" />
                        <Button x:Name="QqSearchButton" Content="搜索" Click="OnQqSearchClick" />
                        <ProgressRing x:Name="QqSearchRing" Width="18" Height="18" IsActive="False" />
                    </StackPanel>
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="QqSuggestions" Spacing="10" Margin="0,4,0,0">
                            <TextBlock x:Name="QqEmptyHint" Text="没有找到结果，换个关键词试试"
                                       FontSize="12.5" Opacity="0.7" Visibility="Collapsed" />
                            <StackPanel x:Name="QqHistoryPanel" Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="搜索历史" FontSize="13" FontWeight="SemiBold" Opacity="0.85" />
                                    <Button Grid.Column="1" x:Name="QqClearHistoryButton" Content="清空"
                                            FontSize="12" Padding="8,2" Background="Transparent" BorderThickness="0"
                                            Opacity="0.7" Click="OnClearHistoryClick" />
                                </Grid>
                                <VariableSizedWrapGrid Orientation="Horizontal" x:Name="QqHistoryList" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="热门搜索" FontSize="13" FontWeight="SemiBold" Opacity="0.85" />
                                <VariableSizedWrapGrid Orientation="Horizontal" x:Name="QqHotList" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <TextBlock Text="点任意一行可直接在线试听；点 ⤓ 下载到本地，下载完自动加入「我的音乐」。"
                                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <Border Grid.Row="1"
                        CornerRadius="10"
                        Padding="18,10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <ListView x:Name="QqResultList"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="OnQqResultClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:OnlineTrackItem">
                                <Grid Padding="4,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border CornerRadius="3" Padding="4,0" Margin="0,1,0,0"
                                                    Background="{ThemeResource WmAccentBrush}"
                                                    Visibility="{x:Bind VipVisibility}">
                                                <TextBlock Text="VIP" FontSize="10" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                            <TextBlock Text="{x:Bind Artist}" FontSize="11.5" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Album}" FontSize="11.5" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DurationText}" FontSize="12" Opacity="0.7"
                                                   MinWidth="46" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ExtraText}" FontSize="11" Opacity="0.5"
                                                   TextAlignment="Right" VerticalAlignment="Center" />
                                        <Button Click="OnQqDownloadClick" Width="38" Height="34" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="下载到本地曲库（m4a）">
                                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <TextBlock Grid.Row="2" Text="最多显示 20 条 · 点行试听，点 ⤓ 下载"
                           FontSize="12" Opacity="0.6" />
            </Grid>

            <!-- ============ 无损音乐 ============ -->
            <Grid x:Name="Net24Section" RowSpacing="8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="Net24QueryBox" Width="380"
                                 PlaceholderText="搜索歌曲 / 歌手（如：晴天 周杰伦）"
                                 KeyDown="OnQueryBoxKeyDown" />
                        <Button x:Name="Net24SearchButton" Content="搜索" Click="OnNet24SearchClick" />
                        <ProgressRing x:Name="Net24SearchRing" Width="18" Height="18" IsActive="False" />
                    </StackPanel>
                    <StackPanel x:Name="Net24ConfigPanel" Orientation="Horizontal" Spacing="8"
                                Margin="0,2,0,0" Visibility="Collapsed">
                        <TextBlock Text="无损站地址" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBox x:Name="Net24UrlBox" Width="320" PlaceholderText="https://（站点首页地址）" />
                        <Button x:Name="Net24SaveButton" Content="保存" Click="OnNet24SaveClick" />
                        <TextBlock Text="该源需要一个自建/自有的无损站地址，保存在本机 settings.json。"
                                   FontSize="11.5" Opacity="0.55" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330" />
                    </StackPanel>
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Net24Suggestions" Spacing="10" Margin="0,4,0,0">
                            <TextBlock x:Name="Net24EmptyHint" Text="没有找到结果，换个关键词试试"
                                       FontSize="12.5" Opacity="0.7" Visibility="Collapsed" />
                            <StackPanel x:Name="Net24HistoryPanel" Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="搜索历史" FontSize="13" FontWeight="SemiBold" Opacity="0.85" />
                                    <Button Grid.Column="1" x:Name="Net24ClearHistoryButton" Content="清空"
                                            FontSize="12" Padding="8,2" Background="Transparent" BorderThickness="0"
                                            Opacity="0.7" Click="OnClearHistoryClick" />
                                </Grid>
                                <VariableSizedWrapGrid Orientation="Horizontal" x:Name="Net24HistoryList" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="热门搜索" FontSize="13" FontWeight="SemiBold" Opacity="0.85" />
                                <VariableSizedWrapGrid Orientation="Horizontal" x:Name="Net24HotList" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <TextBlock Text="无损站：母带 / 环绕 / 无损三档。「母带源」和「无损源」是两套不同的 id，这里按来源分别取档，"
                                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                            <TextBlock Text="对不上号的会被挡掉，不会下错歌。点行可先用无损试听。站点按天限制访问次数，大小是点的时候才去查的，查过一次就会记住。"
                                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <Border Grid.Row="1"
                        CornerRadius="10"
                        Padding="18,10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <ListView x:Name="Net24ResultList"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="OnNet24ResultClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:OnlineTrackItem">
                                <StackPanel Padding="4,8" Spacing="6">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                                <TextBlock Text="{x:Bind Artist}" FontSize="11.5" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Album}" FontSize="11.5" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ExtraText}" FontSize="11" Opacity="0.45" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl Margin="56,0,0,0" ItemsSource="{x:Bind Qualities}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:QualityChipItem">
                                                <Button Click="OnQualityChipClick" Tag="{x:Bind Key}"
                                                        CornerRadius="12" Padding="12,4" FontSize="12"
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        ToolTipService.ToolTip="先查询这个音质档的真实大小，确认后再下载">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon Glyph="&#xE896;" FontSize="12" />
                                                        <TextBlock Text="{x:Bind Label}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <TextBlock Grid.Row="3" Text="点行试听（自动选最小的一档）· 点音质按钮会先查一次大小，确认后再下载"
                           FontSize="12" Opacity="0.6" />
            </Grid>

            <!-- ============ 自定义源（可插拔适配器） ============ -->
            <Grid x:Name="AdapterSection" RowSpacing="8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ComboBox x:Name="AdapterCombo" MinWidth="240" PlaceholderText="（无在线源）" />
                        <Button x:Name="ReloadAdaptersButton" Content="重新加载" ToolTipService.ToolTip="重新扫描适配器目录" />
                        <ProgressRing x:Name="SearchRing" Width="18" Height="18" IsActive="False" />
                    </StackPanel>
                    <TextBlock x:Name="SourceStatus" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                    <TextBlock x:Name="AdapterNote" FontSize="12" Opacity="0.6" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>

                <Border Grid.Row="1"
                        CornerRadius="10"
                        Padding="18,10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="QueryBox" Width="380" PlaceholderText="输入关键词回车搜索"
                                     KeyDown="OnQueryBoxKeyDown" />
                            <Button x:Name="SearchButton" Content="搜索" Click="OnSearchClick" />
                            <TextBlock x:Name="ResultHeader" VerticalAlignment="Center" FontSize="12.5" Opacity="0.8" />
                        </StackPanel>

                        <ListView Grid.Row="1" x:Name="ResultList" SelectionMode="Extended">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:OnlineTrackItem">
                                    <Grid Padding="4,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                                <TextBlock Text="{x:Bind Artist}" FontSize="11.5" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Album}" FontSize="11.5" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ExtraText}" FontSize="11" Opacity="0.45" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DurationText}" FontSize="12" Opacity="0.7" MinWidth="46" TextAlignment="Right" VerticalAlignment="Center" />
                                            <Button Click="OnResultAction" Tag="preview" Width="38" Height="34" Padding="0"
                                                    Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="在线试听">
                                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                            </Button>
                                            <Button Click="OnResultAction" Tag="download" Width="38" Height="34" Padding="0"
                                                    Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="下载到本地曲库">
                                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <ProgressRing x:Name="DownloadRing" Width="16" Height="16" IsActive="False" />
                            <Button x:Name="DownloadSelectedButton" Content="下载所选" IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== status line ===== -->
        <TextBlock Grid.Row="3" x:Name="OnlineStatus"
                   FontSize="12.5" Opacity="0.8" TextWrapping="Wrap" />
    </Grid>
</Page>
