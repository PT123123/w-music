<Window
    x:Class="w_music.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:w_music"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== custom title bar (window content extends into it) ===== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0"
                      Glyph="&#xEC4F;"
                      FontSize="15"
                      Margin="16,0,8,0"
                      Foreground="{ThemeResource WmAccentBrush}" />
            <TextBlock Grid.Column="1"
                       Text="w-music"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Opacity="0.85" />
        </Grid>

        <!-- ===== navigation + page host ===== -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="196">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DiscoverNavItem" Tag="discover" Content="发现">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE10F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="OnlineNavItem" Tag="online" Content="在线发现">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LibraryNavItem" Tag="library" Content="我的音乐">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NowPlayingNavItem" Tag="nowplaying" Content="正在播放">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE93C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- ===== now playing bar ===== -->
        <Border Grid.Row="2"
                Height="92"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid Padding="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- cover placeholder -->
                <Border Grid.Column="0"
                        Width="60" Height="60"
                        CornerRadius="6"
                        Margin="0,0,12,0"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <FontIcon Glyph="&#xEC4F;" FontSize="24" Foreground="{ThemeResource WmAccentBrush}" />
                </Border>

                <!-- title / artist -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NowPlayingTitle"
                               Text="未在播放"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="NowPlayingArtist"
                               FontSize="12"
                               Opacity="0.7"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TimeText"
                               Text="00:00 / 00:00"
                               FontSize="11"
                               Opacity="0.6"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- transport -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="8,0">
                    <Button x:Name="PrevButton" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="上一曲">
                        <FontIcon Glyph="&#xE892;" FontSize="15" />
                    </Button>
                    <Button x:Name="PlayPauseButton" Width="44" Height="44" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="播放 / 暂停">
                        <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="20" />
                    </Button>
                    <Button x:Name="NextButton" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="下一曲">
                        <FontIcon Glyph="&#xE893;" FontSize="15" />
                    </Button>
                    <Button x:Name="ModeButton" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="播放模式">
                        <FontIcon Glyph="&#xE8EE;" FontSize="15" />
                    </Button>
                    <Button x:Name="FavoriteBarButton" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="喜欢">
                        <FontIcon Glyph="&#xEB51;" FontSize="16" />
                    </Button>
                </StackPanel>

                <!-- progress + spectrum -->
                <Grid Grid.Column="3" Margin="12,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Slider x:Name="ProgressSlider"
                            Grid.Row="0"
                            Minimum="0"
                            Maximum="100"
                            StepFrequency="0.5"
                            IsThumbToolTipEnabled="False" />
                    <Canvas x:Name="SpectrumCanvas" Grid.Row="1" Height="26" HorizontalAlignment="Stretch" />
                </Grid>

                <!-- right side -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="LyricButton" Content="歌词" Padding="10,6" ToolTipService.ToolTip="打开歌词页" />
                    <FontIcon Glyph="&#xE767;" FontSize="14" Opacity="0.7" VerticalAlignment="Center" />
                    <Slider x:Name="VolumeSlider" Width="96" Minimum="0" Maximum="1" StepFrequency="0.02" Value="0.8" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
