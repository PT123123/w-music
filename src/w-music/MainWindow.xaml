<Window
    x:Class="w_music.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:w_music"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- RootHost 是整窗唯一一层主题渐变（垂直 上→下 的低亮度暗渐变，见 App.xaml）。
         导航栏 / 页面 / 底部播放条全部透明，于是整块界面共用这一支连续的渐变；
         切主题只改这一个节点的 Background（见 MainWindow::ApplyTheme）。
         初始值给默认主题，避免启动瞬间闪一下。 -->
    <Grid x:Name="RootHost" Background="{StaticResource WmThemeQqGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 标题栏（窗口拖动区） ===== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" />

        <!-- ===== 左侧导航 + 页面宿主 ===== -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="208"
                        Background="Transparent">
            <NavigationView.PaneHeader>
                <Grid Height="60">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,0,0,0" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="8"
                                Background="#F2FFFFFF">
                            <FontIcon Glyph="&#xEC4F;" FontSize="14" Foreground="{ThemeResource WmAccentBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="w-music" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DiscoverNavItem" Tag="discover" Content="发现音乐">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE10F;" FontSize="15" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="OnlineNavItem" Tag="online" Content="在线发现">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" FontSize="15" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LibraryNavItem" Tag="library" Content="我的音乐">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" FontSize="15" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NowPlayingNavItem" Tag="nowplaying" Content="正在播放">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE93C;" FontSize="15" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- ===== 底部播放条 ===== -->
        <Border Grid.Row="2"
                Height="92"
                Background="{ThemeResource WmSideBrush}"
                BorderBrush="{ThemeResource WmBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Padding="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左：封面 + 歌名 / 歌手 / 时间 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="10"
                            Background="{ThemeResource WmPressBrush}">
                        <FontIcon Glyph="&#xEC4F;" FontSize="22" Foreground="{ThemeResource WmAccentBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NowPlayingTitle"
                                   Text="未在播放"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NowPlayingArtist"
                                   FontSize="12"
                                   Opacity="0.7"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TimeText"
                                   Text="00:00 / 00:00"
                                   FontSize="11"
                                   Opacity="0.55"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 中：播放控制 + 进度条 / 频谱 -->
                <Grid Grid.Column="1" Margin="28,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <Button x:Name="PrevButton" Width="36" Height="36" CornerRadius="18" Padding="0"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="上一曲">
                            <FontIcon Glyph="&#xE892;" FontSize="14" />
                        </Button>
                        <Button x:Name="PlayPauseButton" Width="44" Height="44" CornerRadius="22" Padding="0"
                                Background="{ThemeResource WmAccentBrush}" Foreground="White" BorderThickness="0"
                                ToolTipService.ToolTip="播放 / 暂停">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="18" />
                        </Button>
                        <Button x:Name="NextButton" Width="36" Height="36" CornerRadius="18" Padding="0"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="下一曲">
                            <FontIcon Glyph="&#xE893;" FontSize="14" />
                        </Button>
                        <Button x:Name="ModeButton" Width="36" Height="36" CornerRadius="18" Padding="0"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="播放模式">
                            <FontIcon Glyph="&#xE8EE;" FontSize="14" />
                        </Button>
                        <Button x:Name="FavoriteBarButton" Width="36" Height="36" CornerRadius="18" Padding="0"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="喜欢">
                            <FontIcon Glyph="&#xEB51;" FontSize="15" />
                        </Button>
                    </StackPanel>
                    <Grid Grid.Row="1" Height="36">
                        <Slider x:Name="ProgressSlider"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="0.5"
                                IsThumbToolTipEnabled="False"
                                VerticalAlignment="Center"
                                Margin="0,0,0,8" />
                        <Canvas x:Name="SpectrumCanvas" Height="16" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                    </Grid>
                </Grid>

                <!-- 右：主题 + 歌词 + 音量 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- 主题切换：每个色块就是那个主题的渐变底色本身（直接引用
                         App.xaml 里的同一个画刷资源），所以预览和实际界面一致。
                         只有这里影响全局视觉，将来加主题就是加一个 Button。 -->
                    <Button x:Name="ThemeButton" Padding="12,6" CornerRadius="14"
                            ToolTipService.ToolTip="切换界面主题">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE790;" FontSize="14" />
                            <TextBlock Text="主题" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <!-- 弹出层不在根节点的 RequestedTheme 作用域里，单独锁深色 -->
                                <StackPanel Width="236" Spacing="2" RequestedTheme="Dark">
                                    <TextBlock Text="界面主题" FontSize="15" FontWeight="SemiBold"
                                               Margin="4,2,0,8" />
                                    <Button Tag="qq" Click="OnThemeClick" Padding="8,6"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="24" CornerRadius="6"
                                                    Background="{StaticResource WmThemeQqGradient}" />
                                            <TextBlock Grid.Column="1" Text="QQ 绿" FontSize="13"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                            <FontIcon x:Name="ThemeCheckQq" Grid.Column="2" Glyph="&#xE73E;"
                                                      FontSize="14" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button Tag="ocean" Click="OnThemeClick" Padding="8,6"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="24" CornerRadius="6"
                                                    Background="{StaticResource WmThemeOceanGradient}" />
                                            <TextBlock Grid.Column="1" Text="海洋蓝" FontSize="13"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                            <FontIcon x:Name="ThemeCheckOcean" Grid.Column="2" Glyph="&#xE73E;"
                                                      FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </Grid>
                                    </Button>
                                    <Button Tag="sunset" Click="OnThemeClick" Padding="8,6"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="24" CornerRadius="6"
                                                    Background="{StaticResource WmThemeSunsetGradient}" />
                                            <TextBlock Grid.Column="1" Text="日落橙" FontSize="13"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                            <FontIcon x:Name="ThemeCheckSunset" Grid.Column="2" Glyph="&#xE73E;"
                                                      FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </Grid>
                                    </Button>
                                    <Button Tag="galaxy" Click="OnThemeClick" Padding="8,6"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="24" CornerRadius="6"
                                                    Background="{StaticResource WmThemeGalaxyGradient}" />
                                            <TextBlock Grid.Column="1" Text="星空紫" FontSize="13"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                            <FontIcon x:Name="ThemeCheckGalaxy" Grid.Column="2" Glyph="&#xE73E;"
                                                      FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </Grid>
                                    </Button>
                                    <Button Tag="sakura" Click="OnThemeClick" Padding="8,6"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="24" CornerRadius="6"
                                                    Background="{StaticResource WmThemeSakuraGradient}" />
                                            <TextBlock Grid.Column="1" Text="樱粉" FontSize="13"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                            <FontIcon x:Name="ThemeCheckSakura" Grid.Column="2" Glyph="&#xE73E;"
                                                      FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <!-- 均衡器：11 根垂直滑条（前置 + 十段）由代码生成，XAML 只放容器 -->
                    <Button x:Name="EqButton" Padding="12,6" CornerRadius="14"
                            ToolTipService.ToolTip="均衡器">
                        <TextBlock Text="EQ" FontSize="13" />
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <StackPanel Width="452" Spacing="10" RequestedTheme="Dark">
                                    <Grid>
                                        <TextBlock Text="均衡器" FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="EqToggle" HorizontalAlignment="Right"
                                                      MinWidth="0" Padding="0" OnContent="" OffContent="" />
                                    </Grid>
                                    <ComboBox x:Name="EqPresetBox" HorizontalAlignment="Stretch" />
                                    <StackPanel x:Name="EqBandsHost" Orientation="Horizontal" Spacing="4"
                                                HorizontalAlignment="Center" />
                                    <TextBlock FontSize="11" Opacity="0.6" Text="每段 ±12 dB，31 Hz – 16 kHz；关闭时音频直接输出" />
                                    <Button x:Name="EqResetButton" Content="重置" HorizontalAlignment="Right"
                                            Padding="12,4" CornerRadius="12" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="LyricButton" Content="歌词" Padding="12,6" CornerRadius="14"
                            ToolTipService.ToolTip="打开歌词页" />
                    <FontIcon Glyph="&#xE767;" FontSize="14" Opacity="0.7" VerticalAlignment="Center" />
                    <Slider x:Name="VolumeSlider" Width="96" Minimum="0" Maximum="1" StepFrequency="0.02"
                            Value="0.8" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
