namespace w_music
{
    enum PlayMode
    {
        Sequential = 0,
        LoopAll = 1,
        Shuffle = 2,
        RepeatOne = 3,
        /// 推荐流（flow，默认）：下一首从预取缓冲出队（缓冲由本地引擎在
        /// 后台按口味画像补货 + 磁盘缓存垫底），按时间窗整流刷新；缓冲
        /// 空时降级为顺序队列并诚实标注。传统的按文件顺序切歌由
        /// Sequential / LoopAll / Shuffle / RepeatOne 保留。
        Radio = 4,
    };

    /// Everything the UI needs to drive (and observe) the player:
    /// current track, transport state, lyrics and spectrum data.
    runtimeclass PlayerViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        PlayerViewModel();

        /// The underlying MediaPlayer; MediaPlayerElement is wired to it in code.
        Windows.Media.Playback.MediaPlayer Player { get; };

        TrackItem CurrentTrack { get; };
        Boolean HasTrack { get; };
        String Title { get; };
        String Artist { get; };
        String Album { get; };

        Boolean IsPlaying { get; };
        Double PositionSeconds { get; set; };
        Double DurationSeconds { get; };
        String PositionText { get; };
        String DurationText { get; };
        Double Volume { get; set; };
        Boolean IsMuted { get; set; };

        PlayMode Mode { get; set; };
        String ModeText { get; };
        Boolean IsFavorite { get; set; };
        /// 手势反馈的一行轻提示（"已点赞…"），几秒后自动清空；空串 = 不显示。
        String FlowStatusText { get; };

        // ---- 推荐流「接下来」卡片 ----
        /// 当前是否处于推荐流模式（Radio）。
        Boolean IsFlowMode { get; };
        /// 接下来要播的预告：推荐流 = 预取缓冲前 3 行；顺序模式 = 队列预览 1 行
        /// （ScoreText 标「顺序」）；随机模式没有预告。
        Windows.Foundation.Collections.IObservableVector<RecommendItem> FlowUpNext { get; };
        /// 卡片标题：「接下来 · 推荐流（晚间）」/「接下来 · 顺序播放」。
        String FlowHeaderText { get; };
        /// 卡片底部诚实说明：已预载几首 / 引擎预热中 / 随机不预告。
        String FlowStreamText { get; };
        /// 「换一个」按钮只在推荐流模式显示。
        Microsoft.UI.Xaml.Visibility FlowRefreshVisibility { get; };
        /// 点击预告行：直接播放这首（它前面的预告一并作废）。
        void PlayFlowUpNext(Int32 index);
        /// 「换一个」：跳过缓冲头部的预告，后台补一首新的。
        void SkipFlowSlot();
        /// 曲库（重）加载完成：缓存指纹就位，值得再试一次离线种子。
        void NotifyLibraryReady();

        // ---- lyrics ----
        Windows.Foundation.Collections.IObservableVector<LyricLineItem> Lyrics { get; };
        Boolean HasLyrics { get; };
        Int32 ActiveLyricIndex { get; };
        Int64 LyricOffsetMs { get; set; };

        void TogglePlayPause();
        void Next();
        void Previous();
        void Seek(Double seconds);
        void CycleMode();
        void ToggleFavorite();
        /// 点赞当前曲：回传引擎加权口味画像，播放继续。
        void LikeCurrent();
        /// 差评当前曲：回传引擎、从当前播放队列移除，并立即流向下一首相似曲。
        void DislikeCurrent();
        void SetQueue(Windows.Foundation.Collections.IVector<TrackItem> tracks, Int32 startIndex);
        void PlayTrack(TrackItem track);
        void PlayTrackById(String trackId);
        void SeekToLyric(Int32 index);
        void AdjustLyricOffset(Int64 deltaMs);
    }

    /// Library, playlists and the Discover page.
    runtimeclass LibraryViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        LibraryViewModel();

        Windows.Foundation.Collections.IObservableVector<TrackItem> Tracks { get; };
        Windows.Foundation.Collections.IObservableVector<PlaylistItem> Playlists { get; };
        Windows.Foundation.Collections.IObservableVector<TrackItem> DiscoverRecent { get; };
        Windows.Foundation.Collections.IObservableVector<TrackItem> DiscoverTop { get; };
        Windows.Foundation.Collections.IObservableVector<TrackItem> DiscoverShuffle { get; };
        /// Contents of the playlist currently open in the playlist page.
        Windows.Foundation.Collections.IObservableVector<TrackItem> PlaylistTracks { get; };

        Int32 TrackCount { get; };
        String StatusText { get; };
        Boolean IsScanning { get; };
        String CurrentPlaylistName { get; };

        Windows.Foundation.IAsyncAction InitializeAsync(Microsoft.UI.WindowId windowId);
        Windows.Foundation.IAsyncAction AddFolderAsync();
        Windows.Foundation.IAsyncAction RescanAsync();
        void CreatePlaylist(String name);
        void ToggleFavorite(TrackItem track);
        Windows.Foundation.IAsyncAction OpenPlaylistAsync(String playlistId);
        void PlayPlaylist(String playlistId);
        void PlayAll();
    }

    /// The 个性推荐 page: engine status, category chips and the feed /
    /// category / similar lists with their feedback loop. Backed by the local
    /// MIR engine (music-recommend, https://github.com/PT123123/music-recommend).
    runtimeclass RecommendViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        RecommendViewModel();

        /// First entry is the pseudo category "为你推荐" (back to the feed).
        Windows.Foundation.Collections.IObservableVector<CategoryItem> Categories { get; };
        Windows.Foundation.Collections.IObservableVector<RecommendItem> Items { get; };

        String ListHeader { get; };
        String StatusText { get; };
        String FeedStateText { get; };
        /// What the engine's unsupervised pass says about the current library
        /// (k, silhouette, or why it refused to cluster) -- the caption of the
        /// auto-discovered chip row.
        String DiscoveryText { get; };
        /// Honest caveats about the rows now on screen (support size,
        /// estimated filters, words the engine declined to answer).
        String CategoryNote { get; };
        Microsoft.UI.Xaml.Visibility CategoryNoteVisibility { get; };
        /// Id of the active chip; "" = feed, "__similar__" = none,
        /// "__text__" = the free-text query box.
        String SelectedCategoryId { get; };
        Boolean IsBusy { get; };
        /// What the current wait is made of, e.g. "正在启动本地引擎…".
        /// The cold start is seconds long, so a plain "加载中" would not explain it.
        String BusyText { get; };
        /// Cache-first caption, e.g. "以下是 3 分钟前的结果, 正在向引擎要最新的".
        String CacheCaption { get; };
        Microsoft.UI.Xaml.Visibility WaitingVisibility { get; };
        Microsoft.UI.Xaml.Visibility CacheCaptionVisibility { get; };
        Boolean HasItems { get; };
        Microsoft.UI.Xaml.Visibility ItemsVisibility { get; };
        Microsoft.UI.Xaml.Visibility EmptyVisibility { get; };

        Windows.Foundation.IAsyncAction InitializeAsync();
        Windows.Foundation.IAsyncAction RefreshFeedAsync();
        Windows.Foundation.IAsyncAction ShuffleFeedAsync();
        Windows.Foundation.IAsyncAction SelectCategoryAsync(CategoryItem category);
        /// The free Chinese entry: one sentence describing what to listen for.
        Windows.Foundation.IAsyncAction SearchByTextAsync(String text);
        Windows.Foundation.IAsyncAction LoadSimilarNowAsync();
        Windows.Foundation.IAsyncAction AnalyzeLibraryAsync();
        Windows.Foundation.IAsyncAction ResetTasteAsync();
        void PlayItem(RecommendItem item);
        void LikeItem(RecommendItem item);
        void DislikeItem(RecommendItem item);
    }
}
